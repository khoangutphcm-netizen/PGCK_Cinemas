<resources>
    <style name="Theme.Cinema.AdminForm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#101116</item>
        <item name="android:statusBarColor">#101116</item>
        <item name="android:navigationBarColor">#101116</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">#FF6170</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#7DD3C7</item>
        <item name="colorOnSurface">#F1F3F9</item>
        <item name="colorOnSurfaceVariant">#B5BED0</item>
        <item name="colorSurface">#191C25</item>
        <item name="colorOutline">#465064</item>
        <item name="android:textColorPrimary">#F1F3F9</item>
        <item name="android:textColorSecondary">#B5BED0</item>
        <item name="textInputStyle">@style/Widget.Cinema.AdminField</item>
        <item name="materialButtonStyle">@style/Widget.Cinema.AdminButton</item>
    </style>
    <style name="Widget.Cinema.AdminField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">#14171F</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Widget.Cinema.AdminButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#E1E7F4</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">#465064</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
