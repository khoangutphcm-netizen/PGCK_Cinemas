<com.google.android.material.card.MaterialCardView android:id="@+id/editorInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="#191C25" app:strokeColor="#303847" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01  /  THÔNG TIN PHIM" android:textColor="#9BBFFF" android:textSize="13sp" android:layout_marginBottom="10dp"/><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Tên phim"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:inputType="textCapWords"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Mô tả nội dung"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDialogDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:inputType="textMultiLine" android:minLines="3" android:maxLines="6" android:gravity="top"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Năm phát hành · không bắt buộc"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDialogYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:inputType="number" android:maxLength="4"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Tháng phát hành · 1–12"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDialogMonth" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:inputType="number" android:maxLength="2"/></com.google.android.material.textfield.TextInputLayout><RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbTypeStandard" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Phim lẻ / Phim bộ" android:textColor="#F1F3F9"/>
<com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbTypeTrailer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trailer xem trước" android:textColor="#F1F3F9"/>
</RadioGroup></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/editorAppearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="#191C25" app:strokeColor="#303847" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02  /  GIAO DIỆN &amp; POSTER" android:textColor="#C4B5FD" android:textSize="13sp" android:layout_marginBottom="10dp"/><LinearLayout android:id="@+id/titleStyleContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"/><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Đường dẫn ảnh bìa (HTTPS)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDialogThumbnailUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:inputType="textUri"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/btnPickImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn ảnh từ thiết bị"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/editorEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="#191C25" app:strokeColor="#303847" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03  /  THỂ LOẠI &amp; TẬP PHIM" android:textColor="#7DD3C7" android:textSize="13sp" android:layout_marginBottom="10dp"/><TextView android:id="@+id/tvSelectedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E1E7F4" android:textSize="14sp" android:layout_marginBottom="8dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnSelectGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn thể loại"/><com.google.android.material.button.MaterialButton android:id="@+id/btnManageGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quản lý danh mục thể loại"/><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#303847"/><TextView android:id="@+id/tvEpisodesSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E1E7F4" android:textSize="14sp" android:layout_marginBottom="8dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phim lẻ thêm một tập. Phim bộ có thể quản lý thứ tự, phụ đề và lồng tiếng theo từng tập." android:textColor="#B5BED0" android:textSize="13sp" android:layout_marginBottom="10dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnManageEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở danh sách tập phim"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/editorPublishing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="#191C25" app:strokeColor="#303847" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="04  /  HIỂN THỊ &amp; TRAILER" android:textColor="#F7C87D" android:textSize="13sp" android:layout_marginBottom="10dp"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbIsPopular" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nổi bật trên trang chủ" android:textColor="#F1F3F9"/>
