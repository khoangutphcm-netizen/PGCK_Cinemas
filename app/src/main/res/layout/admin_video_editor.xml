<com.google.android.material.chip.Chip android:id="@+id/editorJump0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông tin" android:textColor="#E1E7F4" app:chipBackgroundColor="#242B38" app:chipStrokeColor="#465064" app:chipStrokeWidth="1dp" app:ensureMinTouchTargetSize="true"/><com.google.android.material.chip.Chip android:id="@+id/editorJump1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giao diện" android:textColor="#E1E7F4" app:chipBackgroundColor="#242B38" app:chipStrokeColor="#465064" app:chipStrokeWidth="1dp" app:ensureMinTouchTargetSize="true"/><com.google.android.material.chip.Chip android:id="@+id/editorJump2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tập phim" android:textColor="#E1E7F4" app:chipBackgroundColor="#242B38" app:chipStrokeColor="#465064" app:chipStrokeWidth="1dp" app:ensureMinTouchTargetSize="true"/><com.google.android.material.chip.Chip android:id="@+id/editorJump3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hiển thị" android:textColor="#E1E7F4" app:chipBackgroundColor="#242B38" app:chipStrokeColor="#465064" app:chipStrokeWidth="1dp" app:ensureMinTouchTargetSize="true"/>
