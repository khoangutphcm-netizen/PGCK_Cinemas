rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email','role','createdAt']) && request.resource.data.role == 'user' && request.resource.data.email == request.auth.token.email && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
   match /{section}/{entry} {
    allow read, delete: if signedIn() && request.auth.uid == uid && section in ['watchlist','history'];
    allow create, update: if signedIn() && request.auth.uid == uid && section in ['watchlist','history']
      && request.resource.data.video is map && request.resource.data.updatedAt == request.time
      && (section == 'watchlist' ? request.resource.data.keys().hasOnly(['video','updatedAt']) :
          request.resource.data.keys().hasOnly(['video','updatedAt','episodeNumber','position','duration','completed'])
          && request.resource.data.position is int && request.resource.data.position >= 0
          && request.resource.data.duration is int && request.resource.data.duration > 0
          && request.resource.data.episodeNumber is int && request.resource.data.completed is bool);
   }
  }
  match /videos/{id} { allow read: if true; allow write: if admin(); }
  match /genres/{id} { allow read: if true; allow write: if admin(); }
 }
}
